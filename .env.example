NODE_ENV=development
PORT=4000

# MongoDB (see docker-compose.yml — `npm run db:up`)
MONGODB_URI=mongodb://127.0.0.1:27018/taki_cms

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32+-chars
JWT_EXPIRES_IN=8h
COOKIE_NAME=taki_bo_session
# true in production (HTTPS only cookie)
COOKIE_SECURE=false

# Comma-separated origins allowed to call the API with credentials (the backoffice)
CORS_ORIGINS=http://localhost:3001

# Public website (used for preview links, cache revalidation and static media previews)
SITE_URL=http://localhost:3000
# Shared with the website (.env.local there): CMS_REVALIDATE_SECRET / CMS_PREVIEW_SECRET
SITE_REVALIDATE_SECRET=change-me
PREVIEW_SECRET=change-me-too

# Shared with the website (CMS_FORMS_SECRET there): only the website's server may post form submissions.
# Generate with: openssl rand -hex 32
FORMS_SECRET=change-me-to-a-long-random-string

# Uploads
UPLOAD_DIR=uploads
# CVs received with job applications. Never served statically: downloads go through the authenticated API.
PRIVATE_UPLOAD_DIR=private-uploads
# disk (default) or db: db keeps uploaded files and CVs in MongoDB, for hosts without a persistent disk.
# Moving existing files: FILE_STORAGE=db npm run migrate:files
FILE_STORAGE=disk

# Seed
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@ibtakiacademyschool.com
SEED_ADMIN_PASSWORD=ChangeMe-123!
# Path to the website's public folder (existing images are registered in the media library)
SITE_PUBLIC_DIR=../taki-academy/public
